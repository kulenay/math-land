.map-page {
  min-height: 100vh;
}

.map-scene {
  position: relative;
  min-height: calc(100vh - 120rpx);
  background: linear-gradient(180deg, #aee8f2 0%, #e8f7f5 30%, #cdeff0 100%);
  overflow: hidden;
}

.deco {
  position: absolute;
  font-size: 52rpx;
  opacity: 0.7;
}

.d1 { top: 18%; left: 6%; font-size: 40rpx; }
.d2 { top: 42%; left: 12%; font-size: 44rpx; }
.d3 { bottom: 22%; right: 8%; font-size: 44rpx; }
.d4 { top: 6%; right: 6%; font-size: 60rpx; }

.path {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 56rpx;
  padding: 48rpx 0 80rpx;
}

.path-node {
  position: relative;
  width: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.path-node.left {
  transform: translateX(-120rpx);
}

.path-node.right {
  transform: translateX(120rpx);
}

/* 节点间的路径线 */
.path-node:not(:first-child)::before {
  content: '';
  position: absolute;
  top: -56rpx;
  width: 6rpx;
  height: 56rpx;
  background: repeating-linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.9) 0 10rpx,
    transparent 10rpx 20rpx
  );
  left: 50%;
}

.node-island {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #8fe3b2, #54c98f);
  border: 8rpx solid #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(45, 52, 54, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.node-island.is-current {
  animation: island-pulse 1.6s ease-in-out infinite;
}

@keyframes island-pulse {
  0%, 100% { box-shadow: 0 8rpx 24rpx rgba(45, 52, 54, 0.2), 0 0 0 0 rgba(255, 169, 77, 0.7); }
  50% { box-shadow: 0 8rpx 24rpx rgba(45, 52, 54, 0.2), 0 0 0 20rpx rgba(255, 169, 77, 0); }
}

.node-island.is-locked {
  background: linear-gradient(160deg, #c8d8d5, #a9bfbb);
}

.node-num {
  font-size: 52rpx;
  font-weight: 900;
  color: #ffffff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.node-stars {
  position: absolute;
  bottom: -8rpx;
  display: flex;
  font-size: 26rpx;
}

.node-tap {
  position: absolute;
  bottom: -6rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #ffa94d;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.node-lock {
  font-size: 52rpx;
}

.node-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #2d3436;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
