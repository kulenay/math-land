<view class="page" style="padding-top:{{statusBarHeight}}px">
  <view class="topbar">
    <view></view>
    <view class="topbar-title">数感探索乐园</view>
    <view class="topbar-stars">⭐ {{totalStars}}</view>
  </view>

  <view class="home-frog">
    <text class="frog-body">🐸</text>
    <text class="frog-mood">😊</text>
  </view>
  <view class="home-title">选择探险区域</view>

  <view class="module-grid">
    <view
      class="module-card"
      wx:for="{{moduleCards}}"
      wx:key="id"
      bindtap="onModuleTap"
      data-module="{{item.id}}"
    >
      <view class="module-icon">{{item.emoji}}</view>
      <view class="module-name">{{item.name}}</view>
      <view class="module-desc">{{item.desc}}</view>
      <view class="module-stars">⭐ {{item.stars}}</view>
    </view>

    <view class="module-card locked" wx:for="{{lockedModules}}" wx:key="id" bindtap="onLockedTap">
      <view class="module-icon">{{item.icon}}</view>
      <view class="module-name">{{item.name}}</view>
      <view class="module-desc">{{item.desc}}</view>
      <view class="module-lock">🔒</view>
    </view>
  </view>

  <view class="home-tip">更多区域正在建设中…</view>

  <!-- 生活板块 -->
  <view class="life-section">
    <view class="life-title">🏠 生活板块</view>
    <view class="wallet-entry" bindtap="onWalletTap">
      <view class="wallet-entry-icon">💰</view>
      <view class="wallet-entry-body">
        <view class="wallet-entry-title">数字钱包</view>
        <view class="wallet-entry-desc">做家务挣钱 · 花钱有度 · 储蓄吃利息（零钱 {{walletBalance}} 元）</view>
      </view>
      <view class="wallet-entry-arrow">›</view>
    </view>
  </view>
</view>
