.settings-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: linear-gradient(180deg, #e8f7f5 0%, #f2fbf9 100%);
}

/* ---------- PIN 解锁 ---------- */
.pin-lock {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 0;
}

.pin-icon {
  font-size: 100rpx;
  animation: float 3s ease-in-out infinite;
}

.pin-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #2d3436;
  margin-top: 24rpx;
}

.pin-tip {
  font-size: 26rpx;
  color: #95a5a6;
  margin: 12rpx 0 32rpx;
}

.pin-input {
  width: 320rpx;
  height: 96rpx;
  background: #ffffff;
  border: 4rpx solid #d5e8e5;
  border-radius: 24rpx;
  text-align: center;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 24rpx;
}

.pin-error {
  color: #ff6b6b;
  font-size: 26rpx;
  font-weight: 700;
  margin-top: 16rpx;
}

.pin-btn {
  margin-top: 40rpx;
}

/* ---------- 卡片 ---------- */
.card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 52, 54, 0.08);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #2d3436;
}

.card-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: #95a5a6;
  background: #f4f8f7;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

/* ---------- 配置行 ---------- */
.cfg-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 4rpx;
  border-bottom: 3rpx solid #f0f6f5;
}

.cfg-emoji {
  font-size: 36rpx;
}

.cfg-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #2d3436;
}

.cfg-amount {
  font-size: 24rpx;
  font-weight: 800;
  color: #51cf66;
}

.cfg-amount.spend {
  color: #ff6b6b;
}

.cfg-del {
  padding: 6rpx 16rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #ff6b6b;
  background: #fff0f0;
  border-radius: 12rpx;
}

/* ---------- 新增表单 ---------- */
.cfg-form {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.cfg-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  background: #f4f8f7;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.cfg-input-sm {
  flex: 0 0 100rpx;
  text-align: center;
}

.cfg-input-amt {
  flex: 0 0 110rpx;
  text-align: center;
}

.cfg-add {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  background: linear-gradient(135deg, #4ecdc4, #38d9a9);
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #ffffff;
}

.cfg-add:active {
  transform: scale(0.94);
}

.cfg-label {
  font-size: 24rpx;
  color: #95a5a6;
}

.tip-line {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #d99a00;
  background: #fff7e6;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  line-height: 1.5;
}

/* ---------- 重置 ---------- */
.reset-btn {
  text-align: center;
  padding: 20rpx;
  background: #fff0f0;
  border: 3rpx solid #ff6b6b;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #ff6b6b;
}

.reset-btn:active {
  transform: scale(0.97);
}
