.ai-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #e8f7f5 0%, #f2fbf9 100%);
}

.ai-hero {
  margin: 12rpx 32rpx 16rpx;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #ffffff, #f0fbf8);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 52, 54, 0.08);
}

.ai-hero-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #2d3436;
  text-align: center;
}

/* ---------- 预设问题 ---------- */
.preset-scroll {
  white-space: nowrap;
  padding: 0 24rpx 12rpx;
}

.preset-row {
  display: inline-flex;
  gap: 16rpx;
}

.preset-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: #ffffff;
  border: 3rpx solid #d5e8e5;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(45, 52, 54, 0.06);
}

.preset-chip:active {
  transform: scale(0.95);
}

.preset-chip.disabled {
  opacity: 0.5;
}

.preset-icon {
  font-size: 26rpx;
}

.preset-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #2d3436;
}

/* ---------- 聊天区 ---------- */
.chat-list {
  flex: 1;
  overflow-y: auto;
  padding: 8rpx 28rpx 20rpx;
  box-sizing: border-box;
}

.msg {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(45, 52, 54, 0.1);
}

.msg-bubble {
  max-width: 480rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #2d3436;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(45, 52, 54, 0.08);
}

.msg-user .msg-bubble {
  background: linear-gradient(135deg, #4ecdc4, #38d9a9);
  color: #ffffff;
}

/* 思考中动画 */
.msg-bubble.loading {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 80rpx;
  justify-content: center;
}

.dot {
  font-size: 24rpx;
  color: #4ecdc4;
  animation: dot-bounce 1s ease-in-out infinite;
}

.dot.d2 { animation-delay: 0.15s; }
.dot.d3 { animation-delay: 0.3s; }

@keyframes dot-bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* ---------- 输入区 ---------- */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 3rpx solid #eef4f3;
}

.input-field {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background: #f4f8f7;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.send-btn {
  flex-shrink: 0;
  padding: 16rpx 36rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, #4ecdc4, #38d9a9);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(78, 205, 196, 0.3);
}

.send-btn:active {
  transform: scale(0.94);
}

.send-btn.disabled {
  opacity: 0.5;
}

.cloud-tip {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  color: #ffa94d;
  font-weight: 600;
  background: #fff7e6;
}
